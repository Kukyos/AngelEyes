# Copy to .env and fill in. Never commit .env. See docs/DATA.md -> Keys and costs.
GEMINI_API_KEY=
GROQ_API_KEY=
# OpenRouter-style, pays by UPI. The key file lives on the Desktop, never in the repo.
AIROUTER_API_KEY=
# Free account at cesium.com/ion — streams Google Photorealistic 3D Tiles for the globe
CESIUM_ION_TOKEN=
# Optional: the TfL JamCam endpoint answered without a key
TFL_APP_KEY=
# Responder alerts — pick one (open question in docs/STATE.md)
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Vision-language model for live activity descriptions (OpenAI-compatible; we use Airouter Qwen-VL)
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
