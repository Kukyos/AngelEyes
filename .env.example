# Copy to .env and fill in. Never commit .env.
# Vision-language model (OpenAI-compatible): captions, vision watch rules, compiling typed rules, Ask.
# Without these, everything else runs (detection, tracking, behaviours, pose and pair rules, the screens).
VISION_BASE_URL=https://api.airouter.in/v1
VISION_API_KEY=
VISION_MODEL=alibaba/qwen3-vl-instruct
# Optional: Cesium ion token for 3D terrain on the map (free account at cesium.com/ion). Without it: Esri imagery.
CESIUM_ION_TOKEN=
# Optional: set when the hub is reached from another machine (ngrok, LAN). Every non-loopback client then needs it.
HUB_TOKEN=
